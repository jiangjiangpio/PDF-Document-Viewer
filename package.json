{
  "name": "pdf-document-viewer",
  "productName": "PDF Document Viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Education-focused PDF reader with pen and touch annotations",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build && node scripts/copy-pdf-assets.mjs",
    "dist": "npm run build && electron-builder --win nsis --x64 --publish never",
    "check": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check src/app.js",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "pdfjs-dist": "4.10.38"
  },
  "devDependencies": {
    "concurrently": "9.1.2",
    "cross-env": "7.0.3",
    "electron": "33.4.11",
    "electron-builder": "25.1.8",
    "vite": "6.0.11",
    "wait-on": "8.0.2",
    "playwright-core": "1.51.1"
  },
  "build": {
    "appId": "com.pdfdocumentviewer.desktop",
    "productName": "PDF Document Viewer",
    "artifactName": "PDF-Document-Viewer-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PDF Document Viewer"
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF Document",
        "role": "Viewer"
      }
    ]
  }
}
