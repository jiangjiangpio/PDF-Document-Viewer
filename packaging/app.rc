#include <windows.h>
#pragma code_page(65001)
#include "resources.h"
IDR_TUTORIAL_PDF RCDATA "tutorial.pdf"
IDR_TUTORIAL_INK RCDATA "tutorial.ink"
1 ICON "app.ico"
IDD_CLEAR_INK DIALOGEX 0, 0, 222, 96
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "清除笔迹"
FONT 9, "Microsoft YaHei UI", 400, 0, 1
BEGIN
    CONTROL "", IDC_CLEAR_PROMPT_ICON, "Static", SS_ICON | SS_CENTERIMAGE, 13, 16, 24, 24
    LTEXT "请选择要清除的笔迹范围。", -1, 41, 17, 167, 12
    LTEXT "清除后的笔迹可以撤销恢复。", -1, 41, 37, 167, 12
    PUSHBUTTON "清除当前视图", IDC_CLEAR_CURRENT_VIEW, 12, 72, 45, 16
    PUSHBUTTON "清除当前页", IDC_CLEAR_CURRENT_PAGE, 63, 72, 45, 16
    PUSHBUTTON "清除全部", IDC_CLEAR_ENTIRE_DOCUMENT, 114, 72, 45, 16
    DEFPUSHBUTTON "取消", IDCANCEL, 165, 72, 45, 16
END
#ifndef PAPERVIEW_EXTERNAL_MANIFEST
1 RT_MANIFEST "app.manifest"
#endif
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,6,3,0
 PRODUCTVERSION 0,6,3,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "PDF view"
   VALUE "FileVersion", "0.6.3"
   VALUE "ProductName", "PDF view"
   VALUE "ProductVersion", "0.6.3"
   VALUE "OriginalFilename", "PaperView.exe"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
